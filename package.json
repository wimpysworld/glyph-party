{
  "name": "glyph-party",
  "version": "0.2.0",
  "description": "A beautiful Unicode character search tool for terminal developers",
  "main": "pages/index.html",
  "scripts": {
    "test": "node test/unicode-data.test.js",
    "build:data": "node build-unicode-data.js",
    "dev": "python3 -m http.server 8000 --directory pages",
    "build": "npm run build:data && echo 'Ready for deployment to GitHub Pages!'",
    "clean": "rm -f pages/unicode-data.json pages/unicode-data.min.json"
  },
  "keywords": [
    "unicode",
    "glyph",
    "terminal",
    "cli",
    "symbols",
    "characters",
    "mucss"
  ],
  "author": "Martin Wimpress",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wimpysworld/glyph-party.git"
  },
  "homepage": "https://glyph-party.wimpys.world/"
}
